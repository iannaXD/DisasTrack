{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
      ".write": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
      "Admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "name": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          },
          "email": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          },
          "phone": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          },
          "office": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          },
          "photo": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          },
          "lastLogin": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Admin'"
          }
        }
      },
      "Residents": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "name": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          },
          "email": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          },
          "phone": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          },
          "office": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          },
          "photo": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          },
          "lastLogin": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Resident'"
          }
        }
      },
      "DisasterManagementOfficers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "name": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          },
          "email": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          },
          "phone": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          },
          "office": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          },
          "photo": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          },
          "lastLogin": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer'"
          }
        }
      },
      "RescueTeamMembers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "name": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          },
          "email": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          },
          "phone": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          },
          "office": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          },
          "photo": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          },
          "lastLogin": {
            ".write": "auth != null && auth.uid === $uid && root.child('userRoles').child(auth.uid).val() === 'Rescue Team'"
          }
        }
      },
      "$oldUid": {
        ".read": "auth != null && auth.uid === $oldUid",
        "name": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        },
        "email": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        },
        "phone": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        },
        "office": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        },
        "photo": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        },
        "lastLogin": {
          ".write": "auth != null && auth.uid === $oldUid && data.parent().child('role').exists()"
        }
      }
    },
    "userRoles": {
      ".read": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
      ".write": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === 'Admin' || newData.val() === 'Resident' || newData.val() === 'Disaster Management Officer' || newData.val() === 'Rescue Team'"
      }
    },
    "notificationReads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
        ".validate": "newData.hasChildren(['lastReadAt'])",
        "lastReadAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "auditLogs": {
      ".read": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer' || root.child('users').child(auth.uid).child('role').val() === 'Disaster Management Officer')",
      "$logId": {
        ".write": "auth != null && !data.exists() && newData.child('actorId').val() === auth.uid",
        ".validate": "newData.hasChildren(['timestamp','actorId','category','action'])",
        "timestamp": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "actor": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "role": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "action": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "details": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        }
      }
    },
    "incidents": {
      ".read": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer' || root.child('users').child(auth.uid).child('role').val() === 'Disaster Management Officer' || root.child('userRoles').child(auth.uid).val() === 'Rescue Team')",
      "$id": {
        ".read": "auth != null && data.child('reporterId').val() === auth.uid",
        ".write": "(auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')) || (auth != null && !data.exists() && newData.child('status').val() === 'Pending')",
        ".validate": "newData.hasChildren(['type','location','priority','status','description','createdAt'])",
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "reporter": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "reporterId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "priority": {
          ".validate": "newData.val() === 'Critical' || newData.val() === 'High' || newData.val() === 'Medium' || newData.val() === 'Low'"
        },
        "status": {
          ".write": "auth != null && newData.exists() && root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val() !== null && root.child('incidents').child($id).child('team').val() === root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val()",
          ".validate": "newData.val() === 'Pending' || newData.val() === 'Verified' || newData.val() === 'Awaiting Assignment' || newData.val() === 'Team Assigned' || newData.val() === 'In Progress' || newData.val() === 'Resolved' || newData.val() === 'Duplicate' || newData.val() === 'Rejected' || newData.val() === 'Closed'"
        },
        "photos": {
          ".validate": "newData.isNumber()"
        },
        "lat": {
          ".validate": "newData.isNumber() && newData.val() >= 14.6 && newData.val() <= 15.35"
        },
        "lng": {
          ".validate": "newData.isNumber() && newData.val() >= 120.65 && newData.val() <= 121.4"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "team": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "outcome": {
          ".validate": "newData.hasChildren(['peopleRescued','completedAt'])",
          "peopleRescued": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "completedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "recordedBy": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "sample": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "activity": {
          ".write": "auth != null && root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val() !== null && root.child('incidents').child($id).child('team').val() === root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val()",
          "$i": {
            ".validate": "newData.hasChildren(['text','at'])"
          }
        }
      }
    },
    "rescueTeams": {
      ".read": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin' || root.child('userRoles').child(auth.uid).val() === 'Disaster Management Officer' || root.child('users').child(auth.uid).child('role').val() === 'Disaster Management Officer' || root.child('userRoles').child(auth.uid).val() === 'Rescue Team')",
      ".write": "auth != null && (root.child('userRoles').child(auth.uid).val() === 'Admin' || root.child('users').child(auth.uid).child('role').val() === 'Admin')",
      "$teamId": {
        ".validate": "newData.hasChildren(['name','type'])",
        "status": {
          ".write": "auth != null && root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val() === $teamId",
          ".validate": "newData.val() === 'Available' || newData.val() === 'Standby' || newData.val() === 'Deployed' || newData.val() === 'Off duty'"
        },
        "location": {
          ".write": "auth != null && root.child('users').child('RescueTeamMembers').child(auth.uid).child('teamId').val() === $teamId",
          ".validate": "newData.hasChildren(['lat','lng','updatedAt'])",
          "lat": {
            ".validate": "newData.isNumber() && newData.val() >= 14.6 && newData.val() <= 15.35"
          },
          "lng": {
            ".validate": "newData.isNumber() && newData.val() >= 120.65 && newData.val() <= 121.4"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}